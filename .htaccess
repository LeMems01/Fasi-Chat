# FasiChat Classroom — Configuration Apache
Options -Indexes

# Encodage UTF-8
AddDefaultCharset UTF-8

# Protection des dossiers sensibles
<FilesMatch "\.(php|sql|log|env)$">
    <RequireAll>
        Require all granted
    </RequireAll>
</FilesMatch>

# Interdire l'accès direct aux dossiers de classes/controllers
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^classes/     - [F,L]
    RewriteRule ^controllers/ - [F,L]
    RewriteRule ^config/      - [F,L]
    RewriteRule ^temp/        - [F,L]
</IfModule>

# Cache navigateur pour les assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css         "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg       "access plus 30 days"
    ExpiresByType image/png        "access plus 30 days"
</IfModule>
